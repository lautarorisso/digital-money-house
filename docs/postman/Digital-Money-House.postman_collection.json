{
  "info": {
    "_postman_id": "e9c12f6a-a10a-4a29-ae9b-1584a5d6b9f6",
    "name": "Digital Money House — Sprint 1",
    "description": "Colección de testing exploratorio del Sprint 1: registro, login y logout. Requiere el stack levantado con `docker compose up -d --build` y el environment 'Digital Money House — Local'.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Registro",
      "item": [
        {
          "name": "Registro exitoso",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users-service/users/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Perez\",\n  \"dni\": 30111222,\n  \"email\": \"{{email}}\",\n  \"telefono\": \"+54 11 5555-1234\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.environment.set('email', 'lautaro-' + Date.now() + '@dmh.test');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registro exitoso responde 201', function () {",
                  "    pm.expect(pm.response.code).to.eql(201);",
                  "});",
                  "",
                  "const json = pm.response.json();",
                  "pm.environment.set('userId', json.id);"
                ]
              }
            }
          ]
        },
        {
          "name": "Registro con email duplicado",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": "{{baseUrl}}/users-service/users/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nombre\": \"Juan\",\n  \"apellido\": \"Perez\",\n  \"dni\": 30111222,\n  \"email\": \"{{email}}\",\n  \"telefono\": \"+54 11 5555-1234\",\n  \"password\": \"{{password}}\"\n}"
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Email duplicado responde 400', function () {",
                  "    pm.expect(pm.response.code).to.eql(400);",
                  "});",
                  "pm.test('El mensaje indica que el email ya esta registrado', function () {",
                  "    pm.expect(pm.response.json().message).to.include('Email is already registered');",
                  "});"
                ]
              }
            }
          ]
        },
